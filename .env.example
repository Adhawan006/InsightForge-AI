# ==============================================================================
# InsightForge AI - Enterprise Environment Configuration Template
# ==============================================================================

# Application Meta
PROJECT_NAME="InsightForge AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=insightforge_admin
POSTGRES_PASSWORD=insightforge_secure_password
POSTGRES_DB=insightforge_db
DATABASE_URL=postgresql+asyncpg://insightforge_admin:insightforge_secure_password@localhost:5432/insightforge_db
SYNC_DATABASE_URL=postgresql://insightforge_admin:insightforge_secure_password@localhost:5432/insightforge_db

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
